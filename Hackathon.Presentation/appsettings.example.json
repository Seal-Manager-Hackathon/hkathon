{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // ─────────────────────────────────────────────────────────────
  // CONNECTION STRING (PostgreSQL)
  // ─────────────────────────────────────────────────────────────
  // Format: Host=<host>;Port=<port>;Database=<db>;Username=<user>;Password=<password>
  // Replace the placeholders with your own PostgreSQL instance.
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=seal_db;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD"
  },

  // ─────────────────────────────────────────────────────────────
  // JWT OPTIONS
  // ─────────────────────────────────────────────────────────────
  // SecretKey: a strong random string used to sign access/refresh tokens.
  //   Generate a new one (e.g. 64+ random chars) — never reuse the example.
  // Issuer / Audience: identifiers of your identity server and consumers.
  // ExpireMinutes: access token lifetime in minutes (default 1440 = 24h).
  "JwtOptions": {
    "SecretKey": "REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY",
    "Issuer": "Hackathon_Identity_Server",
    "Audience": "Hackathon_Users",
    "ExpireMinutes": 1440
  },

  // ─────────────────────────────────────────────────────────────
  // CLOUDINARY (image/file upload)
  // ─────────────────────────────────────────────────────────────
  // CloudName / ApiKey / ApiSecret come from your Cloudinary dashboard.
  "CloudinaryOptions": {
    "CloudName": "YOUR_CLOUDINARY_CLOUD_NAME",
    "ApiKey": "YOUR_CLOUDINARY_API_KEY",
    "ApiSecret": "YOUR_CLOUDINARY_API_SECRET"
  },

  // ─────────────────────────────────────────────────────────────
  // MAIL OPTIONS (SMTP — used for email verification & reset password)
  // ─────────────────────────────────────────────────────────────
  // Mail: sender address. Password: SMTP auth (Gmail requires an App Password).
  // Host / Port: SMTP server (smtp.gmail.com:587 for Gmail with STARTTLS).
  // FrontendBaseUrl: where email links (verify/reset) should point to.
  "MailOptions": {
    "Mail": "YOUR_SENDER_EMAIL@gmail.com",
    "DisplayName": "Hackathon Seal",
    "Password": "YOUR_SMTP_APP_PASSWORD",
    "Host": "smtp.gmail.com",
    "Port": 587,
    "FrontendBaseUrl": "http://localhost:3000"
  },

  // ─────────────────────────────────────────────────────────────
  // SECURITY OPTIONS
  // ─────────────────────────────────────────────────────────────
  // Pepper: a secret string appended to passwords before hashing (BCrypt).
  //   Must be the same value across restarts; keep it secret.
  "SecurityOptions": {
    "Pepper": "REPLACE_WITH_A_RANDOM_PEPPER"
  }
}
